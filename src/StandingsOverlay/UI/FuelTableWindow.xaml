<Window x:Class="StandingsOverlay.UI.FuelTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fuel Table"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight">

    <StackPanel x:Name="Root">
        <TextBlock x:Name="EditHint" Text="FUEL TABLE — drag to move" Visibility="Collapsed"
                   FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,3"/>

        <Border x:Name="Panel" Background="#F0212129" CornerRadius="6"
                BorderBrush="#34343F" BorderThickness="1" Padding="10,7,10,8">
            <StackPanel MinWidth="270">
                <!-- Header: FUEL · E—F gauge · current/usable · laps remaining range. -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="FUEL" Foreground="#9DA0AA" FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="E" Foreground="#9DA0AA" FontSize="9"
                                   VerticalAlignment="Center" Margin="0,0,3,0"/>
                        <Border Width="46" Height="8" CornerRadius="2" Background="#2A2A33"
                                BorderBrush="#3A3E48" BorderThickness="1" VerticalAlignment="Center">
                            <Rectangle x:Name="GaugeFill" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5"
                                       Fill="#35A653" Width="0"/>
                        </Border>
                        <TextBlock Text="F" Foreground="#9DA0AA" FontSize="9"
                                   VerticalAlignment="Center" Margin="3,0,8,0"/>
                        <TextBlock x:Name="TankValue" FontFamily="Consolas" FontWeight="Bold" FontSize="14"
                                   Foreground="#E8E9EE" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Rem (Laps)" Foreground="#9DA0AA" FontSize="10"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="RemValue" FontFamily="Consolas" FontWeight="Bold" FontSize="13"
                                   Foreground="#E8E9EE" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Column headers. -->
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Usage (L/Lap)" Foreground="#9DA0AA" FontSize="10"
                               HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Laps to Empty" Foreground="#9DA0AA" FontSize="10"
                               HorizontalAlignment="Center"/>
                </Grid>

                <!-- Table rows, built in code-behind. -->
                <StackPanel x:Name="RowsPanel"/>

                <!-- Target-vs-actual stint tracker. -->
                <Border x:Name="StatusBorder" Margin="0,6,0,0" CornerRadius="3" Padding="6,3"
                        Visibility="Collapsed">
                    <TextBlock x:Name="StatusValue" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold"
                               Foreground="#E8E9EE" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
